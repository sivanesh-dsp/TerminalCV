# ---------------------------------------------------------------------------
# Web build (Vite)
# ---------------------------------------------------------------------------
# Base public path the site is served from.
#   - Vercel / custom domain / Docker+Caddy -> "/" (default, leave unset)
#   - GitHub Pages project site             -> "/<repo-name>/"
# VITE_BASE=/terminal-resume/

# ---------------------------------------------------------------------------
# docker compose (website + SSH server)
# ---------------------------------------------------------------------------
# Public domain. "localhost" makes Caddy issue a local dev certificate; set a
# real domain in production to get an automatic Let's Encrypt certificate.
DOMAIN=localhost

# Host port to expose the SSH server on. Use 22 in production (make sure the
# host's own sshd listens elsewhere). Defaults to 2222 for safe local testing.
SSH_PORT=2222

# Injected into the SSH /version output and build metadata.
VERSION=1.0.0
# BUILD_TIME=2026-01-01T00:00:00Z
