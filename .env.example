# ---------------------------------------------------------------------------
# Web build (Vite)
# ---------------------------------------------------------------------------
# Base public path the site is served from.
#   - Vercel / custom domain / Docker+Caddy -> "/" (default, leave unset)
#   - GitHub Pages project site             -> "/<repo-name>/"
# VITE_BASE=/terminal-resume/

# ---------------------------------------------------------------------------
# docker compose (website + SSH server)
# ---------------------------------------------------------------------------
# Public domain. "localhost" makes Caddy issue a local dev certificate; set a
# real domain in production to get an automatic Let's Encrypt certificate.
DOMAIN=localhost

# Host port to expose the SSH server on. Use 22 in production (make sure the
# host's own sshd listens elsewhere). Defaults to 2222 for safe local testing.
SSH_PORT=2222

# Injected into the SSH /version output and build metadata.
VERSION=1.0.0
# BUILD_TIME=2026-01-01T00:00:00Z

# ---------------------------------------------------------------------------
# Résumé REST API (sibling repository: ../resume-api)
# ---------------------------------------------------------------------------
# Served at https://${DOMAIN}/api/v1 through the Caddy reverse proxy. It mounts
# shared/resume.json READ-ONLY — the single source of truth for the website,
# the SSH terminal and the API alike.

# Build context for the API image in docker-compose.yml (dev only).
RESUME_API_CONTEXT=../resume-api

# Public API base URL. Advertised in the SSH "Contact" tab and used by the
# website when it is served from a different origin than the API.
RESUME_API_URL=https://sivaneshbalaji.online/api/v1

# API settings (all optional — production-safe defaults are built in).
API_ENVIRONMENT=production
API_LOG_LEVEL=INFO
API_METRICS_ENABLED=true
API_RATE_LIMIT_REQUESTS=120
# Comma-separated allow-list. Never "*".
# API_CORS_ALLOW_ORIGINS=https://sivaneshbalaji.online
# Image tag to deploy in production (docker-compose.prod.yml).
# API_IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Web dev server
# ---------------------------------------------------------------------------
# `npm run dev` proxies /api to this target so the site can hydrate from a
# locally running API (cd ../resume-api && make dev).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Override the API base URL baked into the site (default: same-origin /api/v1).
# VITE_API_BASE_URL=https://sivaneshbalaji.online/api/v1
