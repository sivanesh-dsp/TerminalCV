# Caddyfile — serves the static React site with automatic HTTPS.
# DOMAIN defaults to localhost (Caddy issues a local certificate); set it to
# your real domain in production to get a Let's Encrypt certificate.

{$DOMAIN:localhost} {
	root * /srv
	encode zstd gzip

	# SPA-style fallback: unknown paths serve index.html; real files (incl. the
	# résumé PDF) are served directly.
	try_files {path} /index.html
	file_server

	# Long-cache the content-hashed assets, short-cache everything else.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header {
		Cache-Control "public, max-age=3600"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# HTTP access logs → a rolling file on a mounted host volume so they persist
	# on the VM across container rebuilds. Caddy's own operational logs still go
	# to stderr (visible via `docker compose logs web`).
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}
