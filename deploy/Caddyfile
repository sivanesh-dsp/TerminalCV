# Caddyfile — serves the static React site with automatic HTTPS.
# DOMAIN defaults to localhost (Caddy issues a local certificate); set it to
# your real domain in production to get a Let's Encrypt certificate.

# Internal plain-HTTP health endpoint for container health checks. A bare-port
# site is HTTP-only (no automatic-HTTPS redirect, no certificate needed), so a
# probe to 127.0.0.1 succeeds even though the public site forces HTTPS. This
# port is NOT published to the host.
:2021 {
	respond /healthz "ok" 200
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# ---------------------------------------------------------------------
	# REST API — https://<domain>/api/v1/*  (résumé API, FastAPI container).
	# `handle` (not `handle_path`) keeps the /api prefix, because the service
	# owns /api/v1, /api/docs, /api/redoc and /api/openapi.json.
	# The API container is never published to the host: only Caddy reaches it.
	# ---------------------------------------------------------------------
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 2s
				response_header_timeout 10s
			}
		}
	}

	# Friendly alias: /api -> /api/v1
	redir /api /api/v1 permanent

	# ---------------------------------------------------------------------
	# MCP server — https://<domain>/mcp  (résumé MCP server, Streamable HTTP).
	# `handle` (not `handle_path`) keeps the /mcp prefix. Streamable HTTP can
	# hold a POST's response open (an SSE stream) far longer than a typical
	# API call, and a client can also open a long-lived GET stream — both
	# need a generous response timeout and unbuffered flushing.
	# The MCP container is never published to the host: only Caddy reaches it.
	# ---------------------------------------------------------------------
	handle /mcp* {
		reverse_proxy mcp:8001 {
			header_up X-Real-IP {remote_host}
			flush_interval -1
			transport http {
				dial_timeout 2s
				response_header_timeout 15s
			}
		}

		# The MCP server sets its own no-store policy; do not let the
		# static-site cache rules apply.
		header -Cache-Control
	}

	# /healthz, /readyz and /metrics (both the API's and the MCP server's)
	# stay private — never proxied publicly. Reach them over the Docker
	# network or an SSH tunnel, e.g.:
	#   ssh -L 8001:mcp:8001 <vm> && curl localhost:8001/readyz

	# ---------------------------------------------------------------------
	# Static React site — everything else.
	# ---------------------------------------------------------------------
	handle {
		root * /srv

		# SPA-style fallback: unknown paths serve index.html; real files (incl.
		# the résumé PDF) are served directly.
		try_files {path} /index.html
		file_server

		# Long-cache the content-hashed assets, short-cache everything else.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header {
			Cache-Control "public, max-age=3600"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}
	}

	# HTTP access logs → a rolling file on a mounted host volume so they persist
	# on the VM across container rebuilds. Caddy's own operational logs still go
	# to stderr (visible via `docker compose logs web`).
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}
